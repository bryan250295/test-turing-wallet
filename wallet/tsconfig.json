{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": [
			"vite/client",
			"node"
		],
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": [
		"src",
		"server",
		"vite.config.ts"
	]
}
