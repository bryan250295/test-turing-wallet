{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"module": "commonjs",
		"moduleResolution": "node",
		"rootDir": "..",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"../shared/src/**/*.ts"
	],
	"exclude": [
		"src/generated"
	]
}
