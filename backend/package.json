{
	"name": "learning-bridge-backend",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/backend/src/main.js",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:import": "tsx scripts/import-storage.ts",
		"db:studio": "prisma studio",
		"bridge:verify": "tsx scripts/verify-bridge-asset.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.0",
		"@nestjs/core": "^11.1.0",
		"@nestjs/platform-express": "^11.1.0",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/throttler": "^6.4.0",
		"@prisma/client": "7.10.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.6.1",
		"helmet": "^8.1.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tbc-contract": "1.7.3",
		"tbc-lib-js": "1.0.31",
		"viem": "^2.38.0",
		"@prisma/adapter-pg": "7.10.1"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.9",
		"@types/express": "^5.0.3",
		"@types/node": "^22.18.0",
		"prisma": "7.10.1",
		"tsx": "^4.20.0",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@nestjs/platform-express": {
			"multer": "2.5.0"
		},
		"@nestjs/swagger": {
			"js-yaml": "5.5.0"
		}
	}
}
